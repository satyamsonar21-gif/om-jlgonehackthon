// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────





















// ─────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────

model College {
  id        String   @id @default(uuid())
  name      String
  code      String   @unique
  address   String?
  logoUrl   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  students Student[]
  faculty  Faculty[]
}

model Company {
  id          String    @id @default(uuid())
  name        String
  domain      String?
  logoUrl     String?
  website     String?
  description String?
  isVerified  Boolean   @default(false)
  verifiedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  mentors     CompanyMentor[]
  listings    InternshipListing[]
  internships Internship[]
}

model User {
  id           String   @id @default(uuid())
  clerkId      String   @unique
  email        String   @unique
  role String
  name         String
  phone        String?
  profilePhoto String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  student       Student?
  faculty       Faculty?
  companyMentor CompanyMentor?
  notifications Notification[]
}

model Student {
  id           String   @id @default(uuid())
  userId       String   @unique
  studentId    String   @unique
  collegeId    String
  department   String
  year         Int
  cgpa         Float?
  skills       String? // comma-separated
  resumeUrl    String?
  linkedinUrl  String?
  githubUrl    String?
  portfolioUrl String?
  placementReadinessScore Float?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college             College                  @relation(fields: [collegeId], references: [id])
  applications        Application[]
  internships         Internship[]
  facultyAssignments  FacultyStudentAssignment[]
}

model Faculty {
  id          String   @id @default(uuid())
  userId      String   @unique
  facultyId   String   @unique
  collegeId   String
  department  String
  designation String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college            College                  @relation(fields: [collegeId], references: [id])
  internships        Internship[]
  studentAssignments FacultyStudentAssignment[]
}

model FacultyStudentAssignment {
  id        String  @id @default(uuid())
  facultyId String
  studentId String

  faculty Faculty @relation(fields: [facultyId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@unique([facultyId, studentId])
}

model CompanyMentor {
  id          String   @id @default(uuid())
  userId      String   @unique
  companyId   String
  designation String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  company           Company          @relation(fields: [companyId], references: [id])
  internships       Internship[]
  attendanceRecords AttendanceRecord[]
  tasks             Task[]
  feedback          MentorFeedback[]
}

model InternshipListing {
  id             String         @id @default(uuid())
  companyId      String
  title          String
  description    String         
  domain         String
  requiredSkills String? // comma-separated
  mode String
  startDate      DateTime
  endDate        DateTime
  stipend        Float?
  openings       Int            @default(1)
  deadline       DateTime
  status String  @default("OPEN")
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  company      Company       @relation(fields: [companyId], references: [id])
  applications Application[]
}

model Application {
  id                String            @id @default(uuid())
  studentId         String
  listingId         String
  status String @default("SUBMITTED")
  coverLetter       String?           
  submittedAt       DateTime          @default(now())
  facultyApprovedAt DateTime?
  selectedAt        DateTime?

  student    Student           @relation(fields: [studentId], references: [id])
  listing    InternshipListing @relation(fields: [listingId], references: [id])
  internship Internship?

  @@unique([studentId, listingId])
}

model Internship {
  id                  String           @id @default(uuid())
  applicationId       String           @unique
  studentId           String
  companyId           String
  facultyMentorId     String
  companyMentorId     String
  startDate           DateTime
  endDate             DateTime
  status String @default("ACTIVE")
  attendancePercentage Float           @default(0)
  placementReadinessScore Float?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  application   Application   @relation(fields: [applicationId], references: [id])
  student       Student       @relation(fields: [studentId], references: [id])
  company       Company       @relation(fields: [companyId], references: [id])
  facultyMentor Faculty       @relation(fields: [facultyMentorId], references: [id])
  companyMentor CompanyMentor @relation(fields: [companyMentorId], references: [id])

  attendanceRecords AttendanceRecord[]
  dailyLogs         DailyLog[]
  weeklyReports     WeeklyReport[]
  feedback          MentorFeedback[]
  tasks             Task[]
  certificate       Certificate?
}

model AttendanceRecord {
  id           String           @id @default(uuid())
  internshipId String
  date         DateTime
  status String
  markedById   String
  notes        String?
  createdAt    DateTime         @default(now())

  internship Internship    @relation(fields: [internshipId], references: [id])
  markedBy   CompanyMentor @relation(fields: [markedById], references: [id])

  @@unique([internshipId, date])
}

model DailyLog {
  id               String    @id @default(uuid())
  internshipId     String
  date             DateTime
  tasksCompleted   String    
  hoursWorked      Float
  challengesFaced  String?   
  plansForTomorrow String?   
  acknowledgedAt   DateTime?
  createdAt        DateTime  @default(now())

  internship Internship @relation(fields: [internshipId], references: [id])

  @@unique([internshipId, date])
}

model WeeklyReport {
  id              String       @id @default(uuid())
  internshipId    String
  weekNumber      Int
  summary         String       
  keyLearnings    String       
  issuesFaced     String?      
  nextWeekGoals   String       
  fileUrl         String?
  status String @default("SUBMITTED")
  facultyComments String?      
  reviewedAt      DateTime?
  submittedAt     DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  internship Internship @relation(fields: [internshipId], references: [id])

  @@unique([internshipId, weekNumber])
}

model MentorFeedback {
  id              String       @id @default(uuid())
  internshipId    String
  mentorId        String
  type String
  technicalSkills Int
  communication   Int
  problemSolving  Int
  punctuality     Int
  teamwork        Int
  overallRating   Int
  comments        String?      
  submittedAt     DateTime     @default(now())

  internship Internship    @relation(fields: [internshipId], references: [id])
  mentor     CompanyMentor @relation(fields: [mentorId], references: [id])
}

model Task {
  id           String     @id @default(uuid())
  internshipId String
  title        String
  description  String?    
  dueDate      DateTime?
  status String @default("PENDING")
  assignedById String
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  internship Internship    @relation(fields: [internshipId], references: [id])
  assignedBy CompanyMentor @relation(fields: [assignedById], references: [id])
}

model Certificate {
  id                String   @id @default(uuid())
  internshipId      String   @unique
  certificateNumber String   @unique
  issuedAt          DateTime @default(now())
  pdfUrl            String?
  qrCode            String
  isRevoked         Boolean  @default(false)

  internship Internship @relation(fields: [internshipId], references: [id])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  title     String
  message   String           
  type String @default("INFO")
  isRead    Boolean          @default(false)
  link      String?
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}
