rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── HELPER FUNCTIONS ───────────────────────────────────────────────────

    // Is request authenticated?
    function isAuthenticated() {
      return request.auth != null;
    }

    // Is the user the owner of the target document?
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Get the user's current role from existing Firestore document
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    // Check if the authenticated user is an authorized ADMIN
    function isAdmin() {
      return isAuthenticated() && (
        (request.auth.token.role != null && (
          request.auth.token.role == 'ADMIN' ||
          request.auth.token.role == 'SUPER_ADMIN' ||
          request.auth.token.role == 'TNP_ADMIN' ||
          request.auth.token.role == 'HOD_ADMIN'
        )) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserRole() == 'ADMIN' ||
          getUserRole() == 'SUPER_ADMIN' ||
          getUserRole() == 'TNP_ADMIN' ||
          getUserRole() == 'HOD_ADMIN'
        ))
      );
    }

    // Check if user is Faculty Guide
    function isFaculty() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserRole() == 'FACULTY' ||
          getUserRole() == 'FACULTY_MENTOR'
        )) ||
        isAdmin()
      );
    }

    // Check if user is Company Mentor
    function isCompany() {
      return isAuthenticated() && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
          getUserRole() == 'COMPANY' ||
          getUserRole() == 'COMPANY_MENTOR'
        )) ||
        isAdmin()
      );
    }

    // ─── USERS COLLECTION: users/{userId} ───────────────────────────────────
    match /users/{userId} {
      // READ: Users can read their own profile, or authorized Admins can read all profiles
      allow read: if isOwner(userId) || isAdmin();

      // CREATE: Authenticated user creating their own root identity document (matching UID)
      allow create: if isOwner(userId) || isAdmin();

      // UPDATE: Users can update their own document, Admins can update any document
      allow update: if isOwner(userId) || isAdmin();

      // DELETE: Strictly restricted to authorized Administrators
      allow delete: if isAdmin();
    }

    // ─── STUDENTS COLLECTION: students/{uid} ────────────────────────────────
    match /students/{uid} {
      // READ: Authenticated student owner, faculty guides, company supervisors, or admins
      allow read: if isAuthenticated() && (
        isOwner(uid) ||
        isFaculty() ||
        isCompany() ||
        isAdmin()
      );

      // CREATE & UPDATE: Only the student themselves (UID match) or authorized Admins
      // Cross-student modifications are strictly forbidden
      allow create, update: if isAuthenticated() && (
        isOwner(uid) || isAdmin()
      );

      // DELETE: Strictly restricted to authorized Administrators
      allow delete: if isAdmin();
    }

    // ─── FACULTY COLLECTION: faculty/{facultyId} ────────────────────────────
    match /faculty/{facultyId} {
      // READ: Authenticated users can view faculty supervisor directory
      allow read: if isAuthenticated();

      // CREATE & UPDATE: Only the faculty owner (UID match) or authorized Admins
      // Cross-faculty modifications are strictly forbidden
      allow create, update: if isAuthenticated() && (
        isOwner(facultyId) ||
        (resource != null && isOwner(resource.data.userId)) ||
        isAdmin()
      );

      // DELETE: Strictly restricted to authorized Administrators
      allow delete: if isAdmin();
    }

    // ─── COMPANY MENTORS COLLECTION: companyMentors/{mentorId} ─────────────
    match /companyMentors/{mentorId} {
      // READ: Authenticated users can view corporate mentor directory
      allow read: if isAuthenticated();

      // CREATE & UPDATE: Only the corporate mentor owner (UID match) or authorized Admins
      allow create, update: if isAuthenticated() && (
        isOwner(mentorId) ||
        (resource != null && isOwner(resource.data.userId)) ||
        isAdmin()
      );

      // DELETE: Strictly restricted to authorized Administrators
      allow delete: if isAdmin();
    }

    // ─── COMPANIES COLLECTION: companies/{companyId} ────────────────────────
    match /companies/{companyId} {
      // READ: Authenticated users can view corporate partner directory
      allow read: if isAuthenticated();

      // CREATE & UPDATE: Only the corporate mentor owner (UID match) or authorized Admins
      // Cross-company modifications are strictly forbidden
      allow create, update: if isAuthenticated() && (
        isOwner(companyId) ||
        (resource != null && isOwner(resource.data.userId)) ||
        isAdmin()
      );

      // DELETE: Strictly restricted to authorized Administrators
      allow delete: if isAdmin();
    }

    // ─── ADMINS COLLECTION: admins/{adminId} ────────────────────────────────
    match /admins/{adminId} {
      // READ: Admin owner or authorized Administrators
      allow read: if isAuthenticated() && (isOwner(adminId) || isAdmin());

      // CREATE & UPDATE: Admin owner or authorized Administrators
      allow create, update: if isAuthenticated() && (isOwner(adminId) || isAdmin());

      // DELETE: Strictly restricted to authorized Administrators
      allow delete: if isAdmin();
    }

    // ─── INTERNSHIPS COLLECTION: internships/{internshipId} ─────────────────
    match /internships/{internshipId} {
      // READ: All authenticated students, faculty, companies, and admins
      allow read: if isAuthenticated();

      // CREATE: Company mentors or Administrators
      allow create: if isCompany() || isAdmin();

      // UPDATE & DELETE: Owning company mentor or Administrators
      allow update, delete: if isAdmin() || (
        isCompany() && (
          resource == null ||
          resource.data.companyId == request.auth.uid ||
          resource.data.userId == request.auth.uid
        )
      );
    }

    // ─── APPLICATIONS COLLECTION: applications/{applicationId} ──────────────
    match /applications/{applicationId} {
      // READ: Student applicant, assigned company supervisor, faculty guide, or admin
      allow read: if isAuthenticated() && (
        (resource != null && isOwner(resource.data.studentId)) ||
        isCompany() ||
        isFaculty() ||
        isAdmin()
      );

      // CREATE: Authenticated student applying for internship (matching studentId to auth.uid)
      allow create: if isAuthenticated() && (
        request.resource.data.studentId == request.auth.uid || isAdmin()
      );

      // UPDATE: Student updating own application, or Company/Faculty/Admin reviewing application
      allow update: if isAuthenticated() && (
        (resource != null && isOwner(resource.data.studentId)) ||
        isCompany() ||
        isFaculty() ||
        isAdmin()
      );

      // DELETE: Admin or student withdrawing an initial 'APPLIED' application
      allow delete: if isAdmin() || (
        isAuthenticated() &&
        resource != null &&
        isOwner(resource.data.studentId) &&
        resource.data.status == 'APPLIED'
      );
    }

    // ─── AUDIT LOGS: audit_logs/{logId} (Cryptographic Security Ledger) ───────
    match /audit_logs/{logId} {
      // READ: Strictly restricted to Administrators for compliance
      allow read: if isAdmin();

      // CREATE: Automated platform audit trail logging
      allow create: if isAuthenticated();

      // UPDATE & DELETE: Strictly immutable — tamper-proof audit trail
      allow update, delete: if false;
    }
  }
}
